{
  "name": "simple-osc-lib",
  "version": "1.1.3",
  "description": "Simple to use modern Open Sound Control implementation",
  "main": "index.js",
  "scripts": {
    "test:coverage": "npm test -- --coverage",
    "test": "jest",
    "docs:coverage": "tsc && node build/getOSCCoverage",
    "docs:jsdoc": "tsc && npx jsdoc-to-markdown --partial build/osc-coverage.hbs --template build/readme_template.hbs ./dist/index.js ./dist/x32.js > README.md",
    "docs": "tsc && npm run docs:coverage && npm run docs:jsdoc",
    "build": "tsc", 
    "prepare": "npm run build",
    "pretest": "npm run build"
  },
  "keywords": [
    "osc"
  ],
  "homepage": "https://github.com/jtsage/node-simple-osc-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtsage/node-simple-osc-lib.git"
  },
  "bugs": "https://github.com/jtsage/node-simple-osc-lib/issues/",
  "author": {
    "name": "J.T.Sage",
    "email": "jtsage@gmail.com"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^15.2.0",
    "jest": "^29.7.0",
    "jsdoc-to-markdown": "^8.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "license": "ISC",
  "jest": {
    "verbose": false,
    "errorOnDeprecated": true,
    "coverageReporters": [
      "json-summary",
      "text",
      "html"
    ]
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
