{
  "name": "simple-osc-lib",
  "version": "1.9.9",
  "description": "Simple to use modern Open Sound Control implementation",
  "main": "dist/index.js",
  "scripts": {
    "test:coverage": "npm test -- --coverage",
    "test": "jest",
    "docs": "npx tsc && node ./build/make_readme.js",
    "build": "npx tsc",
    "prepare": "npm run build",
    "pretest": "npm run build"
  },
  "keywords": [
    "osc"
  ],
  "homepage": "https://github.com/jtsage/node-simple-osc-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtsage/node-simple-osc-lib.git"
  },
  "bugs": "https://github.com/jtsage/node-simple-osc-lib/issues/",
  "author": {
    "name": "J.T.Sage",
    "email": "jtsage@gmail.com"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^15.2.0",
    "jest": "^29.7.0",
    "tsdoc-markdown": "^1.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "license": "ISC",
  "jest": {
    "verbose": false,
    "errorOnDeprecated": true,
    "coverageReporters": [
      "json-summary",
      "text",
      "html"
    ]
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
